{
	"name": "@afterpython/project-website-template",
	"version": "0.5.3",
	"license": "Apache-2.0",
	"type": "module",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.10.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build && vpx scripts/inject-comments.ts build && pagefind --site build",
		"build:watch": "vp build --watch --mode development",
		"preview": "vp preview",
		"serve": "pnpx serve build",
		"build:dev-content": "vpx scripts/build-dev-content.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "vp fmt .",
		"lint": "vp fmt --check . && vp lint ."
	},
	"devDependencies": {
		"@pagefind/component-ui": "^1.6.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"eslint-plugin-svelte": "^3.24.0",
		"highlight.js": "^11.12.0",
		"marked": "^18.1.3",
		"marked-gfm-heading-id": "^4.1.4",
		"marked-highlight": "^2.2.4",
		"mdsvex": "^0.12.8",
		"mystmd": "^1.12.0",
		"pagefind": "^1.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#static/*": "./static/*"
	}
}
